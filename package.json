{
  "name": "ekin",
  "private": true,
  "version": "1.17.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.app.json && vite build && node scripts/check-precache.mjs",
    "sync-exercises": "node scripts/build-exercises.mjs",
    "import-wger": "node scripts/import-wger.mjs",
    "translate-instructions": "node scripts/translate-instructions.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type:check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && svelte-check --tsconfig ./tsconfig.test.json --fail-on-warnings",
    "check": "npm run format:check && npm run lint && npm run type:check && npm run test:run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "svelte-i18n": "^4.0.1",
    "uuidv7": "^1.2.1"
  },
  "overrides": {
    "esbuild": "^0.28.0",
    "minimatch": "^11.0.1",
    "workbox-build": {
      "glob": "^13.0.0"
    }
  }
}
