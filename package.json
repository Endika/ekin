{
  "name": "ekin",
  "private": true,
  "version": "1.15.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "sync-exercises": "node scripts/build-exercises.mjs",
    "import-wger": "node scripts/import-wger.mjs",
    "translate-instructions": "node scripts/translate-instructions.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . && prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "svelte-i18n": "^4.0.1",
    "uuidv7": "^1.2.1"
  },
  "overrides": {
    "esbuild": "^0.28.0"
